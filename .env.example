# Contentful space settings (Settings -> API keys)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ENVIRONMENT=master

# Content Delivery API token. Read-only and published content only,
# so it is safe to ship to the browser.
VITE_CONTENTFUL_ACCESS_TOKEN=

# Content Management API token (Settings -> CMA tokens).
# Used only by the Node scripts in scripts/contentful. Never prefix it with VITE_.
CONTENTFUL_MANAGEMENT_TOKEN=
